root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# ktlint, run through spotless (`./gradlew spotlessApply`). The Gradle daemon keeps the ktlint settings it read
# first, so run `./gradlew --stop` after changing them here.
[*.{kt,kts}]
ktlint_code_style = intellij_idea
max_line_length = 140
# Composable functions are named like types (PascalCase)
ktlint_function_naming_ignore_when_annotated_with = Composable

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml,json}]
indent_size = 2
